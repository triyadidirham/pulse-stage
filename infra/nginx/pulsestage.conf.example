# For Nginx installed directly on the host, not inside a container.
# Replace the hostname; keep the upstream port in sync with APP_PORT.
# If this domain already has an HTTPS virtual host, merge the location and
# access_log directives into that host and preserve its TLS configuration.
# Otherwise this HTTP host can be used to bootstrap a certificate with Certbot.
server {
    listen 80;
    server_name pulse.example.com;

    # Overlay URLs contain bearer tokens: do not put them in access logs.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:3012;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Forward SSE updates immediately and allow the connection to stay open.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        gzip off;
    }
}
